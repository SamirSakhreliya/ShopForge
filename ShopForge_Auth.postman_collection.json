        {
          "name": "GET /api/v2/me — any authenticated user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const role = pm.response.json().data.user.role;",
                  "pm.test('role is one of the three', () => {",
                  "  pm.expect(['Customer','Vendor','SuperAdmin']).to.include(role);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v2/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "me"]
            }
          }
        },
        {
          "name": "GET /api/v2/products — Customer+Vendor pass, SuperAdmin gets 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const status = pm.response.code;",
                  "pm.test('200 (Customer|Vendor) or 403 (SuperAdmin)', () => {",
                  "  pm.expect([200, 403]).to.include(status);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v2/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "products"]
            }
          }
        },
        {
          "name": "[Negative] Malformed token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('success false', () => pm.expect(pm.response.json().success).to.be.false);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer this.is.not.a.valid.jwt"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v2/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "me"]
            }
          }
        }
      ]
    }
  ]
}
